# Copy to .env and replace every "change-me" with a random value, e.g. `openssl rand -hex 16`.
# These are throwaway credentials for the local test network only. Never use production values.

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
# Shared between Velocity (modern forwarding), Paper and the Minestom lobby.
VELOCITY_FORWARDING_SECRET=change-me
# RCON of Paper and Velocity (used by rcon-cli and the luckperms-init container).
RCON_PASSWORD=change-me

# Ports published on the host (bound to 127.0.0.1 only, except the proxy).
PROXY_PORT=25565
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# true: players must own a Minecraft account (Mojang auth on the proxy).
# false: offline mode, any name works; handy for several test clients at once.
PROXY_ONLINE_MODE=true

# Pinned server versions.
PAPER_VERSION=26.3
PAPER_BUILD=259
VELOCITY_VERSION=4.3.1
